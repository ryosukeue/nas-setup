[Unit]
Description=Photo NAS owner dashboard API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/nas-admin-service
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/gunicorn --bind 127.0.0.1:8787 --workers 2 --access-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
